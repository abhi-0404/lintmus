# Copy to .env and fill in. Never commit .env.
# Keys come from the Flagsmith dashboard: Environment > Settings > Keys.
# The Node SDK scripts accept a client-side or a server-side key for events.

# Browser app (Vite exposes VITE_* to the client). Client-side environment key for the
# environment this deployment serves: `real` for lintmus, `sim` for lintmus-sim-demo.
VITE_FLAGSMITH_ENVIRONMENT_KEY=

# Node scripts: one key per Flagsmith environment.
FLAGSMITH_ENV_KEY_REAL=
FLAGSMITH_ENV_KEY_SIM=
# Optional extra environments (only if the plan allows them).
FLAGSMITH_ENV_KEY_SIM_AA=
FLAGSMITH_ENV_KEY_SIM_MDE=
FLAGSMITH_ENV_KEY_SIM_HARM=
FLAGSMITH_ENV_KEY_SIM_SRM=

# Optional: events API URL override (self-hosted only). Default is the public Flagsmith events API.
FLAGSMITH_EVENTS_API_URL=
# Optional: API URL override (self-hosted only).
FLAGSMITH_API_URL=

# Browser app: set to "sim" on the lintmus-sim-demo deployment (shows the red SIMULATION DEMO banner).
VITE_LINTMUS_ENV=
# Browser app, self-hosted Flagsmith only.
VITE_FLAGSMITH_API_URL=
VITE_FLAGSMITH_EVENTS_API_URL=
